
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Reset Your Password | FlowMotion</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f2f7;
    font-family: Arial, Helvetica, sans-serif;
    color: #25212d;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f4f2f7; padding: 40px 15px;">

        <tr>
            <td align="center">

                <!-- MAIN CONTAINER -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="
                        max-width: 520px;
                        background-color: #ffffff;
                        border-radius: 14px;
                        overflow: hidden;
                    ">

                    <!-- LOGO HEADER -->
                    <tr>
                        <td align="center"
                            style="
                                background-color: #08050c;
                                padding: 28px 20px;
                            ">

                            <img
                                src="https://i.ibb.co.com/ZRcfN1Yd/logo.png"
                                alt="flowMotion"
                                width="180"
                                style="
                                    display: block;
                                    width: 180px;
                                    max-width: 100%;
                                    height: auto;
                                    border: 0;
                                "
                            />

                        </td>
                    </tr>

                    <!-- CONTENT -->
                    <tr>
                        <td style="padding: 40px 35px 30px;">

                            <p style="
                                margin: 0 0 12px;
                                color: #8c65d8;
                                font-size: 11px;
                                font-weight: bold;
                                letter-spacing: 2px;
                                text-transform: uppercase;
                            ">
                                ACCOUNT SECURITY
                            </p>

                            <h2 style="
                                margin: 0 0 20px;
                                color: #17121f;
                                font-size: 25px;
                                line-height: 1.35;
                                font-weight: 700;
                            ">
                                Reset your password
                            </h2>

                            <p style="
                                margin: 0 0 16px;
                                color: #45404d;
                                font-size: 14px;
                                line-height: 1.8;
                            ">
                                Hello <%= name %>,
                            </p>

                            <p style="
                                margin: 0 0 28px;
                                color: #77717f;
                                font-size: 14px;
                                line-height: 1.8;
                            ">
                                We received a request to reset the password
                                associated with your FlowMotion account.
                                Click the button below to create a new password
                                and regain access to your account.
                            </p>

                            <!-- RESET BUTTON -->
                            <table cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center"
                                        style="
                                            background-color: #8b5cf6;
                                            border-radius: 8px;
                                        ">

                                        <a
                                            href="<%= resetUiLink %>"
                                            target="_blank"
                                            style="
                                                display: inline-block;
                                                padding: 14px 30px;
                                                color: #ffffff;
                                                font-size: 13px;
                                                font-weight: bold;
                                                text-decoration: none;
                                                letter-spacing: 0.3px;
                                            "
                                        >
                                            Reset Password &rarr;
                                        </a>

                                    </td>
                                </tr>
                            </table>

                            <!-- EXPIRY NOTICE -->
                            <table width="100%" cellpadding="0" cellspacing="0"
                                border="0"
                                style="
                                    margin-top: 30px;
                                    background-color: #f8f6fc;
                                    border-left: 3px solid #8b5cf6;
                                    border-radius: 5px;
                                ">
                                <tr>
                                    <td style="padding: 15px 16px;">

                                        <p style="
                                            margin: 0 0 5px;
                                            color: #42334f;
                                            font-size: 12px;
                                            font-weight: bold;
                                        ">
                                            Important security notice
                                        </p>

                                        <p style="
                                            margin: 0;
                                            color: #77717f;
                                            font-size: 12px;
                                            line-height: 1.7;
                                        ">
                                            This password reset link will expire
                                            in 10 minutes. If you did not request
                                            this change, you can safely ignore
                                            this email.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                            <p style="
                                margin: 28px 0 0;
                                color: #77717f;
                                font-size: 12px;
                                line-height: 1.7;
                            ">
                                If the button doesn't work, copy and paste
                                the following link into your browser:
                            </p>

                            <p style="
                                margin: 8px 0 0;
                                font-size: 11px;
                                line-height: 1.7;
                                word-break: break-all;
                            ">
                                <a href="<%= resetUiLink %>"
                                    style="color: #8b5cf6; text-decoration: none;">
                                    <%= resetUiLink %>
                                </a>
                            </p>

                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td align="center"
                            style="
                                background-color: #08050c;
                                padding: 25px 20px;
                            ">

                            <p style="
                                margin: 0 0 12px;
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: bold;
                                letter-spacing: 0.5px;
                            ">
                                FlowMotion
                            </p>

                            <p style="
                                margin: 0 0 15px;
                                color: #9992a3;
                                font-size: 11px;
                                line-height: 1.7;
                            ">
                                Create. Customize. Build your flow.
                            </p>

                            <p style="
                                margin: 0 0 15px;
                                font-size: 11px;
                            ">
                                <a href="http://localhost:3000/privacy-policy"
                                    style="
                                        color: #b69af5;
                                        text-decoration: none;
                                    ">
                                    Privacy Policy
                                </a>

                                <span style="color: #62596e; padding: 0 8px;">
                                    |
                                </span>

                                <a href="http://localhost:3000/terms"
                                    style="
                                        color: #b69af5;
                                        text-decoration: none;
                                    ">
                                    Terms of Service
                                </a>
                            </p>

                            <p style="
                                margin: 0;
                                color: #716a7b;
                                font-size: 10px;
                                line-height: 1.6;
                            ">
                                &copy; 2026 FlowMotion. All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
